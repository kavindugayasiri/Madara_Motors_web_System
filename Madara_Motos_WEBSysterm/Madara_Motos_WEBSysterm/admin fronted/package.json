{
    "name": "react-vite-tailwind",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "start": "vite --host 0.0.0.0 --port 3000 --open",
        "dev": "vite --host 0.0.0.0 --port 3000 --open",
        "build": "vite build",
        "preview": "vite preview --host 0.0.0.0 --port 3000 --open",
        "start-backend": "cd ../backend && mvnw spring-boot:run",
        "start-all": "concurrently \"npm run start-backend\" \"npm run dev\""
    },
    "dependencies": {
        "axios": "^1.15.2",
        "clsx": "^2.1.1",
        "framer-motion": "^12.38.0",
        "lucide-react": "^1.11.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-router-dom": "^7.14.2",
        "recharts": "^3.8.1",
        "tailwind-merge": "3.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.1.17",
        "@types/node": "22.19.17",
        "@types/react": "19.2.7",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.1.1",
        "concurrently": "^9.2.1",
        "tailwindcss": "4.1.17",
        "typescript": "5.9.3",
        "vite": "7.2.4",
        "vite-plugin-singlefile": "2.3.0"
    }
}